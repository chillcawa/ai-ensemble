{
  "name": "ai-ensemble",
  "private": true,
  "version": "1.3.4",
  "description": "Desktop client for comparing responses from multiple AI providers",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "node scripts/build-release.mjs",
    "tauri:build:raw": "tauri build",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^5.6.2",
    "vite": "^5.4.6",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
